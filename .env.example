# Application Configuration
APP_NAME="Family Expense Manager API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (JSON array of allowed origins or comma-separated strings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://10.0.2.2:8000","*"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=family_expense_manager

# Optional direct Database URL override (e.g., for cloud providers like Neon, Supabase, RDS)
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/family_expense_manager

# Security & JWT Secrets (Replace with generated secret: openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-super-secret-hex-key-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Logging
LOG_LEVEL="INFO"
